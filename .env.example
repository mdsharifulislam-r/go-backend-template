# App
APP_ENV=development
IP_ADDRESS=0.0.0.0
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=go_backend
DB_SSLMODE=disable

# Auth
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_IN=7d

# Email (optional in development — OTP is logged to console when empty)
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com

# Seeded super admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=password@123
